# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, used for invite creation. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback only — magic-link/invite redirects are derived from the
# actual request's origin (see lib/site-url.ts and app/login/page.tsx), so this
# is just a last-resort default and does NOT need to match your deployed domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cal.com (Settings -> Developer -> API keys). Coach-managed calendar sync.
CAL_COM_API_KEY=
# Cal.com username the coach's booking page/events live under
CAL_COM_USERNAME=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
