# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, used for invite creation. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL of this app, used to build invite/magic-link redirect URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cal.com (Settings -> Developer -> API keys). Coach-managed calendar sync.
CAL_COM_API_KEY=
# Cal.com username the coach's booking page/events live under
CAL_COM_USERNAME=

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
